    { "id": "s3", "kind": "side", "text": "order mux: MSB vs LSB first", "row": 4, "col": 1, "w": 210 },
    { "id": "s4", "kind": "process", "text": "MAXLEN >= 2 (elaboration guard)", "row": 5, "col": 1, "w": 210 },
