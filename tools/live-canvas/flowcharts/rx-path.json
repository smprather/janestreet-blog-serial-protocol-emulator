    { "id": "e3", "kind": "process", "text": "shift register captures the bit at the configured edge", "row": 2, "col": 0, "w": 320 },
    { "id": "e4", "kind": "decision", "text": "word complete?\n(bits_left == 0)", "row": 3, "col": 0, "w": 320 },
