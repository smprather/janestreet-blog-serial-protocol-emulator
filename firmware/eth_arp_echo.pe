        OUT   ENGINE, A          ; push byte 24

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll25:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push25
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll25
push25:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 25

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll26:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push26
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll26
push26:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 26

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll27:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push27
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll27
push27:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   1
        OUT   ENGINE, A          ; push byte 27

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll28:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push28
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll28
push28:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A, 192
        OUT   ENGINE, A          ; push byte 28

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll29:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push29
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll29
push29:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A, 168
        OUT   ENGINE, A          ; push byte 29

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll30:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push30
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll30
push30:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   1
        OUT   ENGINE, A          ; push byte 30

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll31:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push31
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll31
push31:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,  10
        OUT   ENGINE, A          ; push byte 31

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll32:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push32
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll32
push32:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 32

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll33:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push33
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll33
push33:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 33

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll34:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push34
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll34
push34:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 34

        IN    A, ENGINE          ; re-arm; INDEX=next
