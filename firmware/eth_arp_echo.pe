        JNZ   push35
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll35
push35:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 35

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll36:  IN    A, ENGINE          ; TXSTAT, INDEX=28
