        JNZ   push36
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll36
push36:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 36

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll37:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push37
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll37
push37:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 37

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll38:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push38
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll38
push38:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A, 192
        OUT   ENGINE, A          ; push byte 38

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll39:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push39
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll39
push39:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A, 168
        OUT   ENGINE, A          ; push byte 39

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll40:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push40
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll40
push40:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   1
        OUT   ENGINE, A          ; push byte 40

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll41:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push41
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll41
push41:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,  20
        OUT   ENGINE, A          ; push byte 41

        ; --- wait for the latched done (TXSTAT bit1) ---------------
        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
donep:  IN    A, ENGINE          ; TXSTAT (set beats clear), INDEX=28
        AND   A, 2               ; tx_done latched
        JNZ   tx_ok
        LDI   A, 27
        OUT   ENGINE, A
        JMP   donep
tx_ok:  LDI   A, 0xA5
        STM   11, A              ; TX half complete

        ; ---- the wire loopback: walk the frame the RX chain stored ---
        ; The chip is talking to itself: the TX pad drives pin_in[7], the
        ; real pe_dru -> pe_manch -> pe_eth_mac chain stores the frame,
        ; and this is firmware/eth_rx.pe's poll/walk loop over the result.
        ; DMEM contract: [0..1] len, [2..3] EtherType, [5] sum,
        ; [6] walk counter, [7] 0x5A consumed, [8] rejected count,
        ; [9] raw ETHSTAT, [11] TX half done, [10] 0xA5 whole echo done.
        LDI   A, 0
        STM   8, A
        STM   7, A
        STM   10, A

main:   IN    A, ETHSTAT           ; returns is_type|bad|valid; clears events
        STM   9, A
        AND   A, 1                 ; bit0: a frame is ready
        JNZ   got_frame
        LDM   A, 9
        AND   A, 2                 ; bit1: a frame was rejected
        JZ    main
        LDM   A, 8
        ADD   A, 1
        STM   8, A
        JMP   main

got_frame:
        IN    A, ETHLEN
        STM   0, A
        IN    A, ETHLENH
        STM   1, A
        IN    A, ETHFLD
        STM   2, A
        IN    A, ETHFLDH
        STM   3, A
        LDM   A, 0                 ; the length is the walk count
        STM   6, A
        LDI   A, 0
        STM   5, A

sum:    LDM   A, 6
        JZ    walked
        IN    A, BUFBYTE           ; one byte; the window advances
        MOV   X, A
        LDM   A, 5
        ADD   A, X                 ; sum += byte
        STM   5, A
        LDM   A, 6
        SUB   A, 1
        STM   6, A
        JMP   sum

walked: LDI   A, 1
        OUT   BUFCTRL, A           ; release the bytes just walked
        LDI   A, 0x5A
        STM   7, A                 ; the TB's consumption flag
        LDI   A, 0xA5
        STM   10, A                ; the whole echo is done
halt:   JMP   halt
