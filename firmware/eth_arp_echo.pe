poll15:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push15
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll15
push15:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
