        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll16:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push16
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
