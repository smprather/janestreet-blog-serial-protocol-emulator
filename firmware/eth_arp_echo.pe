        OUT   ENGINE, A          ; push byte 17

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll18:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push18
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll18
push18:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   6
        OUT   ENGINE, A          ; push byte 18

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll19:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push19
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll19
push19:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   4
        OUT   ENGINE, A          ; push byte 19

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll20:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push20
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll20
push20:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A,   0
        OUT   ENGINE, A          ; push byte 20

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll21:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push21
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll21
push21:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
