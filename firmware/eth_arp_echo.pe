        OUT   ENGINE, A          ; push byte 22

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll23:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
