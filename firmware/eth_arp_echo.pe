        OUT   ENGINE, A          ; push byte 11

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll12:  IN    A, ENGINE          ; TXSTAT, INDEX=28
