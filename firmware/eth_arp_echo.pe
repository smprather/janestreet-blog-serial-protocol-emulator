        OUT   ENGINE, A          ; push byte 21

        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 (TXSTAT)
poll22:  IN    A, ENGINE          ; TXSTAT, INDEX=28
        AND   A, 16              ; fifo_ready
        JNZ   push22
        LDI   A, 27
        OUT   ENGINE, A          ; INDEX=27 again
        JMP   poll22
push22:  LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
