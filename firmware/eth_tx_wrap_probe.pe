; eth_tx_wrap_probe.pe — the 16-23 window push-bank wrap directed case
; (deferred from Task 3; manager Task 11).
;
; TXLEN is written 42, then NINE bytes are pushed in ONE DATA-phase burst
; starting at index 16. The window's push bank must wrap 23 -> 16, so the
; ninth push lands in the bank and TXLEN (index 24) keeps its value; a wrap
; that fell through would write TXLENL with the ninth byte. The program
; reads REG[24] and REG[26] back to dmem for the testbench.
;
; DMEM: [0]=REG[24] (want 42), [1]=REG[26] (want 4: tx_path at bit2),
;       [8]=0xA5 done.

        ; --- TXLEN=42 (index 24/25) then tx_path (index 26) ---
        LDI   A, 24
        OUT   ENGINE, A          ; INDEX=24
        LDI   A, 42
        OUT   ENGINE, A          ; TXLENL=42, INDEX=25
        LDI   A, 0
        OUT   ENGINE, A          ; TXLENH=0, INDEX=26
        LDI   A, 4
        OUT   ENGINE, A          ; TXCTRL bit2 tx_path=1, INDEX=27

        ; --- nine pushes in one burst: 16,17,...,23,16,17 ---
        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 16
        OUT   ENGINE, A          ; INDEX=16
        LDI   A, 0x11
        OUT   ENGINE, A          ; push 1
        LDI   A, 0x22
        OUT   ENGINE, A          ; push 2
        LDI   A, 0x33
        OUT   ENGINE, A          ; push 3
        LDI   A, 0x44
        OUT   ENGINE, A          ; push 4
        LDI   A, 0x55
        OUT   ENGINE, A          ; push 5
        LDI   A, 0x66
        OUT   ENGINE, A          ; push 6
        LDI   A, 0x77
        OUT   ENGINE, A          ; push 7
        LDI   A, 0x88
        OUT   ENGINE, A          ; push 8 (index 23 -> wraps to 16)
        LDI   A, 0x99
        OUT   ENGINE, A          ; push 9 at 16; a no-wrap bug writes TXLENL

        ; --- read REG[24] back ---
        IN    A, ENGINE          ; re-arm; INDEX=next
        LDI   A, 24
        OUT   ENGINE, A          ; INDEX=24
        IN    A, ENGINE          ; REG[24] = TXLENL
        STM   0, A

        ; --- read REG[26] back ---
        LDI   A, 26
        OUT   ENGINE, A          ; INDEX=26
        IN    A, ENGINE          ; REG[26] = {tx_path at bit2}
        STM   1, A

        LDI   A, 0xA5
        STM   8, A               ; done
halt:   JMP   halt
