; uart_echo.pe — a UART implemented entirely in software for pe_cpu.
;
; THERE IS NO UART HARDWARE. The SoC provides one input pin, one output pin,
; and a free-running counter. Finding the start bit, aligning to bit centres,
; shifting bits in, assembling bytes and framing the response are all below.
;
; 115200 8N1, LSB-first. Receive a byte, buffer it, echo it back.
;
; ---------------------------------------------------------------------------
; TIMING MODEL
;
; TIMER (port 5) is an 8-bit counter incrementing once per HALF bit period
; (260 clocks at 60 MHz/115200/2 -- integer division, so the delivered baud is
; 115,385, +0.16% of nominal). Half-bit resolution is required, not
; luxurious: sampling on whole-bit ticks can only land on bit BOUNDARIES, the
; worst possible place to sample a serial line.
;
;      2 ticks == 1 bit period        1 tick == half a bit
;
; The falling edge is the start of the START bit. Bit 0's centre is 3 ticks
; after that edge; every bit after it is +2 ticks.
;
; ---------------------------------------------------------------------------
; THE POLLING IDIOM, AND WHY IT LOOKS ODD
;
; The obvious way to wait for a tick is to read STATUS and loop until bit 0 is
; set. That DOES NOT WORK here: reading STATUS clears the flag, so the very
; read that would exit the loop destroys the evidence, and the loop spins
; forever. (This was the first bug found by tools/peemu.py, and it is exactly
; the kind of thing a bit-accurate emulator is for.)
;
; Instead the code polls the TIMER VALUE and waits for it to CHANGE:
;
;     hold:  IN A, TIMER
;            MOV Y, A            ; Y = current count
;     wait:  IN A, TIMER
;            SUB A, Y            ; non-zero once the count moved on
;            JZ wait
;
; This idiom costs 4 instructions and needs no flag at all. What it costs
; instead is SAMPLING MARGIN, and the real number is worth stating plainly
; because an earlier version of this comment overstated it ("2 ticks of
; margin, so a sample landing 1 tick early still reads the right bit").
;
; The timer free-runs and is NOT synchronised to the start-bit edge. A wait
; that snapshots the count and loops until it changes therefore returns after
; anywhere in (0, 1] ticks, not after 1 tick: if the counter happens to be
; about to increment, the first wait falls through almost immediately.
;
; So the 3-tick alignment below actually lands somewhere in (2, 3] ticks after
; the falling edge. Bit 0 spans ticks 2..4 and its centre is at 3, which means:
;
;   * every sample is inside the correct bit cell -- the +2-tick steps after it
;     are exact, so the whole byte inherits one offset and decodes as one,
;   * but the offset can be up to a full tick (HALF A BIT) early, and the worst
;     case sits exactly on the boundary between the start bit and bit 0.
;
; That is inherent to a free-running tick: the alignment quantum is one tick,
; so a half-bit of uncertainty cannot be removed by counting more ticks -- a
; 4-tick wait just moves the same window onto the trailing boundary instead.
; Removing it needs a sub-tick delay (roughly 130 clocks of counted NOPs) to
; recentre the window on (2.5, 3.5]. That is a real improvement and it is not
; done here; it is recorded in wiki/plans/through-i2c.md as a follow-up,
; because this UART is verified at the pin and the change would need requalifying.
;
; It works today because the baud error is +0.16%, which is 0.03 ticks of drift
; across a 10-bit frame -- far too small to walk a sample out of its cell.
; ---------------------------------------------------------------------------
;
; Data buffer (DMEM, 16 bytes). The buffer is 0..7 and the scalars live above
; it; nothing overlaps, which the previous version of this map got wrong -- it
; claimed the buffer ran 0..13 while slots 12 and 13 held the working
; accumulator and the bit counter, and slot 14 held the pointer itself. A
; pointer that ever reached 12 would have eaten the byte it was assembling.
;
;   0..7   rolling receive buffer (8 entries, wraps with AND 0x07)
;   8      tick snapshot (Y is enough, but RAM survives the shift code)
;   9      ticks-to-skip counter
;   12     working accumulator
;   13     bits remaining
;   14     write pointer
;   15     last byte received (the echo source)

        LDI   A, 0
        STM   14, A                ; write pointer := 0

; =========================================================== receive
main:
        ; ---- wait for the start bit: poll until the pin goes low -----
wait_start:
        ; Edge detection, not level. After transmitting, the line is still high,
        ; and a bare level test would immediately "find" a start bit that is not
        ; there. So: wait for the line to go idle (high), then wait for it to
        ; fall. Both loops are level tests; the SEQUENCE is what makes it an
        ; edge. At boot the line is already high, so the first loop falls
        ; straight through -- which is the correct behaviour.
wait_idle:
        IN    A, PIN
        AND   A, 8                 ; the port is 8 bits; bit 3 is RX
        JZ    wait_idle            ; line low -> still in the previous frame
wait_low:
        IN    A, PIN
        AND   A, 8
        JNZ   wait_low             ; line high -> not yet a start bit
        ; falling edge seen: the start bit begins here

        ; ---- skip 3 half-ticks: land on bit 0's CENTRE --------------
        LDI   A, 3
        STM   9, A
        JMP   align_first

; ---- alignment: wait 3 ticks, then sample each bit 2 ticks apart ---
align_first:
        IN    A, TIMER
        STM   8, A
wt1:
        IN    A, TIMER
        LDM   X, 8
        SUB   A, X
        JZ    wt1
        LDM   A, 9
        SUB   A, 1
        STM   9, A
        JNZ   align_first

        ; ---- sample 8 data bits -------------------------------------
        ; Bit-serial assembly with no shift-left: shift the ACCUMULATOR right
        ; and insert each new bit at the top. After 8 LSB-first bits the
        ; first-received bit has walked down to bit 0.
        LDI   A, 8
        STM   13, A
        LDI   A, 0
        STM   12, A

bit_loop:
        LDM   A, 12
        SHR   A                    ; acc >>= 1, top bit vacated
        STM   12, A

        IN    A, PIN               ; sample at the bit centre
        AND   A, 8                 ; the port is 8 bits; bit 3 is RX
        JZ    no_bit
        LDM   A, 12
        ADD   A, 0x80              ; set the top bit (ADD is safe: it is 0)
        STM   12, A
no_bit:
        ; ---- advance 2 half-ticks to the next bit centre ------------
        LDI   A, 2
        STM   9, A
skip2:
        IN    A, TIMER
        STM   8, A
skip2w:
        IN    A, TIMER
        LDM   X, 8
        SUB   A, X
        JZ    skip2w
        LDM   A, 9
        SUB   A, 1
        STM   9, A
        JNZ   skip2

        LDM   A, 13
        SUB   A, 1
        STM   13, A
        JNZ   bit_loop

        ; ---- byte complete: buffer it -------------------------------
        LDM   A, 12
        STM   15, A                ; echo source
        LDM   A, 14
        MOV   X, A                 ; X := write pointer
        LDM   A, 15
        STS   [X], A               ; buffer[ptr] := byte
        LDM   A, 14
        ADD   A, 1
        ; Wrap within the 8-entry buffer. This was AND 0x0E, which is not a
        ; wrap at all: it clears bit 0, so ptr+1 = 1 masked back to 0 and the
        ; pointer never left slot 0. Every byte overwrote the same cell and the
        ; echo path (which reads slot 15) never noticed. 0x07 is the mask for
        ; an 8-entry buffer, and 8 is what fits below the scalars at 8..15.
        AND   A, 0x07              ; wrap within 0..7
        STM   14, A

; =========================================================== transmit
        ; ---- half-duplex: wait for the line to go idle ------------------
        ; The sender is still clocking out its STOP bit when we finish
        ; sampling bit 7. Driving TX now would mean two drivers on the wire at
        ; once, and the sender would see our start bit in place of its stop
        ; bit. Wait for idle (high) before taking the line.
tx_waitidle:
        IN    A, PIN
        AND   A, 8                 ; the port is 8 bits; bit 3 is RX
        JZ    tx_waitidle

        LDI   A, 0
        OUT   TXPIN, A             ; start bit: low
        ; ---- wait 2 timer ticks (1 bit period) ----------------------
        ; Snapshot the timer ONCE, then poll until (now - snapshot) != 0.
        ; The poll must jump back to the POLL, not to the snapshot: taking a
        ; new snapshot each iteration means the delta is always ~0 and the
        ; loop falls through instantly.
        LDI   A, 2
        STM   9, A
tx_start:
        IN    A, TIMER
        STM   8, A
tx_startw:
        IN    A, TIMER
        LDM   X, 8
        SUB   A, X
        JZ    tx_startw
        LDM   A, 9
        SUB   A, 1
        STM   9, A
        JNZ   tx_start

        LDM   A, 15
        STM   12, A                ; working copy
        LDI   A, 8
        STM   13, A
tx_loop:
        LDM   A, 12
        AND   A, 1                 ; isolate LSB
        OUT   TXPIN, A             ; drive it

        LDI   A, 2
        STM   9, A
tx_bit:
        IN    A, TIMER
        STM   8, A
tx_bitw:
        IN    A, TIMER
        LDM   X, 8
        SUB   A, X
        JZ    tx_bitw
        LDM   A, 9
        SUB   A, 1
        STM   9, A
        JNZ   tx_bit

        LDM   A, 12                ; next bit
        SHR   A
        STM   12, A
        LDM   A, 13
        SUB   A, 1
        STM   13, A
        JNZ   tx_loop

        LDI   A, 1
        OUT   TXPIN, A             ; stop bit: high
        LDI   A, 2
        STM   9, A
tx_stop:
        IN    A, TIMER
        STM   8, A
tx_stopw:
        IN    A, TIMER
        LDM   X, 8
        SUB   A, X
        JZ    tx_stopw
        LDM   A, 9
        SUB   A, 1
        STM   9, A
        JNZ   tx_stop

        JMP   main
