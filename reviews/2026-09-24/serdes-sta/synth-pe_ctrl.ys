# flatten, check -assert, no-attr netlist). pe_ctrl is unchanged since the A1
# readback landed, so this reproduces the recorded manager-A1 netlist modulo
# the flow's flatten/clean step.
read_liberty -lib /home/mylesp/pdk/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib
