  // ---- range_never_wraps (v07-range_never_wraps) ----
  begin : r2_v7
    // Every vector model_image[].state starts faults=0 and
    // words_written=3. faults is a STICKY DUT register, so the
    // only host-reachable way to that precondition is CLEAR_FAULT;
    // words_written=3 is established by the opening LOAD replay.
    // This is a host-side precondition, NOT a weakening of the
    // chip: without it a fault latched by one vector leaks into the
    // next, which the first added step (at_ceiling_15) caught.
    r2_preload_load();
    r2_clear_faults();
    r2_imem[0] = r2_imem_img[0];
    r2_imem[1] = r2_imem_img[1];
