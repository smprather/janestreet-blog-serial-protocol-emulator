// R2_CONFORMANCE_RUN — generated from the gui-worker golden package
// (tb/r2-vectors/manifest.json, WITH the model image and the NEW
// read-ceiling / zero-count steps). Per the package load procedure:
// imem.hex + dmem.hex are the base image, each vector applies its sparse
// overrides, and the architectural registers are preloaded from
// model_images[].state. Icarus does no runtime JSON, so the per-vector
// preloads are generated here. Everything the chip owes (framing, order,
// bounds, status, CRC, byte order, fault lifecycle) is compared
// byte-exactly against response_file.
task automatic r2_run_all;
  begin
    $readmemh("../tb/r2-vectors/imem.hex", r2_imem_img);
    $readmemh("../tb/r2-vectors/dmem.hex", r2_dmem_img);
    r2_preload_load();
  end
  // ---- read_imem_bounded (v01-read_imem_bounded) ----
  begin : r2_v1
    // Every vector model_image[].state starts faults=0 and
    // words_written=3. faults is a STICKY DUT register, so the
    // only host-reachable way to that precondition is CLEAR_FAULT;
    // words_written=3 is established by the opening LOAD replay.
    // This is a host-side precondition, NOT a weakening of the
    // chip: without it a fault latched by one vector leaks into the
    // next, which the first added step (at_ceiling_15) caught.
    r2_preload_load();
    r2_clear_faults();
    r2_imem[0] = r2_imem_img[0];
    r2_imem[1] = r2_imem_img[1];
    r2_imem[2] = r2_imem_img[2];
    r2_imem[3] = r2_imem_img[3];
    r2_imem[4] = r2_imem_img[4];
    r2_imem[5] = r2_imem_img[5];
    r2_imem[6] = r2_imem_img[6];
    r2_imem[7] = r2_imem_img[7];
    r2_imem[8] = r2_imem_img[8];
